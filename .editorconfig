# EditorConfig: the same indent rules whether you use VS Code, Cursor, or vim.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# YAML and Markdown are conventionally spaces (GitHub, Prettier defaults).
[*.{yml,yaml,md,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
